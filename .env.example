# Fast default: use Gemini for quick cloud generation.
# If you want a fully local model instead, set LLM_BACKEND=ollama and install Ollama.
LLM_BACKEND=gemini

# Optional deployment settings
PORT=5000
UPLOAD_FOLDER=uploads

# Only needed if LLM_BACKEND=gemini - get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here
